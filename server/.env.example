# Copy this file to .env and fill in the values.
PORT=4000

# MongoDB connection string (local or MongoDB Atlas).
# Leave empty in development to use a local file (data/dev-db.json) instead.
MONGODB_URI=

# Long random strings. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
TOTP_ENC_KEY=

ACCESS_TOKEN_TTL=7d
APP_NAME=StaySupply
CORS_ORIGIN=*
